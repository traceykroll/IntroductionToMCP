# Copy to .env in the dab/ folder and set your own password.
# MSSQL_CONNECTION_STRING is the support rep login; the _SUPERVISOR string is
# used only by dab-config.supervisor.json. Both logins are created in 01_schema.sql.
#
# Adjust the port if SQL Server is not on 1433.

MSSQL_CONNECTION_STRING=Server=localhost,1433;Database=BayStateSupply;User Id=bss_support_rep;Password=CHANGE_ME;TrustServerCertificate=True
MSSQL_CONNECTION_STRING_SUPERVISOR=Server=localhost,1433;Database=BayStateSupply;User Id=bss_support_supervisor;Password=CHANGE_ME;TrustServerCertificate=True