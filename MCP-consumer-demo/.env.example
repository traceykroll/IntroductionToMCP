# Copy to .env in the dab/ folder and set your own password.
# The MCP server connects with the read-only login created by 01_schema.sql.
#
# Adjust the port if SQL Server is not on 1433.

MSSQL_CONNECTION_STRING=Server=localhost,1433;Database=BayStateSupply;User Id=bss_mcp_reader;Password=CHANGE_ME;TrustServerCertificate=True
